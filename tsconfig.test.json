{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"incremental": false,
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"lib": ["es2022", "dom"],
		"types": ["node"]
	},
	"include": [
		"credentials/**/*",
		"nodes/**/*",
		"test/**/*.mts",
		"tests_e2e/**/*.mts",
		"*.mts"
	]
}
